# OAWO Mühasibat — reverse proxy + TLS.
#
# Cloudflare proxy (turuncu bulud) ilə işləyir:
#  - Cloudflare istifadəçiyə öz (avtomatik) SSL sertifikatını verir;
#  - origin serverdə isə bu Caddy 443-də `tls internal` ilə öz-özünə
#    imzalanmış sertifikat yaradır və avtomatik yeniləyir — heç bir əl ilə
#    sertifikat, token və ya renewal lazım deyil.
#
# Cloudflare SSL/TLS rejimi: "Full"  (strict YOX).
# "Full" origin sertifikatını yoxlamır, ona görə self-signed kifayətdir,
# amma Cloudflare↔origin trafiki yenə də şifrələnir.

{
	admin off
	email ceo@oawo.com
}

accounting.oawo.com {
	encode zstd gzip
	tls internal
	reverse_proxy app:8080
}
