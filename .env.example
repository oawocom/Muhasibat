# OAWO Mühasibat — mühit dəyişənləri.
# Bu faylı .env kimi kopyalayın və dəyərləri doldurun:  cp .env.example .env
# .env git tərəfindən izlənmir, ona görə "git pull" heç vaxt münaqişə yaratmaz.

# Token imzası — uzun təsadüfi dəyər (məs: openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# İlk superadmin
ADMIN_EMAIL=admin@oawo.com
ADMIN_PASSWORD=admin123

# Verilənlər bazası şifrəsi (postgres)
DB_PASSWORD=oawo

# Default tenant/şirkət adı (yalnız ilk açılışda istifadə olunur)
COMPANY_NAME=OAWO
